<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Lockwright.Base" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pp_inter</item>
        <item name="android:textColor">@color/pp_text_primary</item>
    </style>

    <style name="TextAppearance.Lockwright.Caption" parent="TextAppearance.Lockwright.Base">
        <item name="android:textSize">@dimen/pp_font_s12</item>
    </style>

    <style name="TextAppearance.Lockwright.Label" parent="TextAppearance.Lockwright.Base">
        <item name="android:textSize">@dimen/pp_font_s14</item>
    </style>

    <style name="TextAppearance.Lockwright.LabelEmphasized" parent="TextAppearance.Lockwright.Base">
        <item name="android:textSize">@dimen/pp_font_s14</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.Lockwright.Body" parent="TextAppearance.Lockwright.Base">
        <item name="android:textSize">@dimen/pp_font_s16</item>
    </style>

    <style name="TextAppearance.Lockwright.BodyEmphasized" parent="TextAppearance.Lockwright.Base">
        <item name="android:textSize">@dimen/pp_font_s16</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.Lockwright.Title" parent="TextAppearance.Lockwright.Base">
        <item name="android:fontFamily">@font/humble_nostalgia</item>
        <item name="android:textSize">@dimen/pp_font_s28</item>
    </style>
</resources>
